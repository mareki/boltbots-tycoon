-- Roblox Studio CLI RunScript static/data smoke; NOT a multiplayer Play test.
local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
assert(shared ~= nil, "Missing ReplicatedStorage.Shared")
local Config = require(shared:FindFirstChild("GameConfig"))
local Rules = require(shared:FindFirstChild("EconomyRules"))
assert(Config.project == "BoltBotsTycoon", "Incorrect project name")
assert(Config.maxPlots == 4, "Unexpected plot count")
assert(Rules.upgradePrice(1) == 50, "Incorrect first price")
assert(Rules.upgradePrice(Config.maxUpgradeLevel) == nil, "Max level must be bounded")
local profile = Rules.newProfile()
assert(profile.cash == 0, "Wrong initial balance")
local ok, reason = Rules.tryUpgrade(profile)
assert(not ok and reason == "INSUFFICIENT_CASH", "Cannot buy without cash")
assert(profile.cash == 0 and profile.upgradeLevel == 1, "Rejected upgrade mutated state")
Rules.awardRobot(profile)
Rules.awardRobot(profile)
assert(profile.cash == 50 and profile.robots == 2, "Production reward invalid")
ok, reason = Rules.tryUpgrade(profile)
assert(ok and reason == "UPGRADED", "Upgrade should succeed with funds")
assert(profile.cash == 0 and profile.upgradeLevel == 2, "Upgrade mutation invalid")
assert(Rules.cycleSeconds(2) < Rules.cycleSeconds(1), "Upgrade must speed up production")
local serverScripts = game:GetService("ServerScriptService"):FindFirstChild("Server")
assert(serverScripts ~= nil, "Server script container not present")
assert(serverScripts:FindFirstChild("Main") ~= nil, "Main server script missing")
assert(serverScripts:FindFirstChild("Services") ~= nil, "Services folder missing")
print("BOLTBOTS_SMOKE_OK", Config.project, Config.versionLabel)
